<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ClassTell</RootNamespace>
    <AssemblyName>ClassTell</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>installer\ClassTell.ico</ApplicationIcon>
    <AssemblyTitle>ClassTell</AssemblyTitle>
    <Product>ClassTell</Product>
    <Company>ClassTell</Company>
    <Copyright>ClassTell</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- 发行标记（1.0.0_r）：显示在程序的“关于 → 开发者信息”与文件属性的“产品版本”里；
         MSBuild/NuGet 的 Version 仍必须是纯数字，故此处用 InformationalVersion 承载；
         关闭“附加 git 提交号”以保证属性里显示的就是 1.0.0_r -->
    <InformationalVersion>1.0.0_r</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />
  </ItemGroup>

  <!-- 自测工程使用自己的 csproj，不能被打进主工程 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="info.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="使用说明.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
